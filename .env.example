# Modelo do arquivo .env -- copie para "orquestracao/.env" e preencha SE quiser
# mudar algum padrao. Aqui ficam so' os NOMES; nenhum valor. A demonstracao roda
# sem .env nenhum (os padroes estao entre parenteses).
#
# Segredo de verdade (se um dia houver) nao e' lido com os.getenv solto: passa por
# core/credenciais.py::obter_credencial(nome), o ponto unico para ligar num cofre.

# Agendamento (orquestracao/agendamento.py), formato cron
ORQUESTRACAO_CRON=
# (padrao "0 3 * * *": pipeline completo de madrugada)
AVISO_PRAZO_CRON=
# (padrao "0 12 * * *": aviso de prazo de comodato ao meio-dia)

# Nova tentativa de um script que falhou (orquestracao/flows.py::rodar_script)
ORQUESTRACAO_RETRIES=
# (padrao 1)
ORQUESTRACAO_RETRY_DELAY_SEGUNDOS=
# (padrao 300)

# Nivel de log do proprio Prefect (padrao WARNING)
PREFECT_LOGGING_LEVEL=

# 1 = scripts gravam so' o .parquet final, nada no "banco" (usado por gerar_parquet.bat)
SOMENTE_PARQUET=

# Remetente do aviso de prazo de comodato (padrao: um endereco @example.com)
EMAIL_REMETENTE_PADRAO=
